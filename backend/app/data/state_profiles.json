{
  "_meta": {
    "description": "State-level agro-climatic profiles for India. Soil NPK and pH are indicative district-averaged values derived from Soil Health Card (soilhealth.dac.gov.in) portal aggregates; temperature/humidity/rainfall are IMD 1991-2020 climatological normals. v1 uses these curated averages; v2 replaces them with live Soil Health Card + Open-Meteo lookups per district.",
    "units": {
      "N": "kg/ha available nitrogen",
      "P": "kg/ha available phosphorus",
      "K": "kg/ha available potassium",
      "temperature": "degrees C, annual mean",
      "humidity": "percent, annual mean relative humidity",
      "ph": "soil pH (1:2.5 water extract)",
      "rainfall_annual_mm": "mm, mean annual rainfall (IMD normals)"
    },
    "model_input_note": "The classifier was trained on per-growing-cycle rainfall (range 20-299 mm), not annual totals. The model feature is derived as rainfall_annual_mm / 12 (mean monthly). rainfall_annual_mm itself is used for the irrigation-gap calculation."
  },
