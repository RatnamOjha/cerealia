{
  "_meta": {
    "description": "Per-crop economics used to convert agro-climatic suitability into expected net profit per hectare. MSP figures are GoI 2024-25 announced Minimum Support Prices (CACP). Non-MSP crops use indicative mandi modal prices from Agmarknet. Yields are national averages (Agricultural Statistics at a Glance). Costs are indicative A2+FL cost of cultivation.",
    "units": {
      "price_per_quintal": "INR per quintal (100 kg)",
      "yield_t_ha": "tonnes per hectare per harvest cycle",
      "opex_per_ha": "INR per hectare per cycle (seed, fertiliser, labour, irrigation)",
      "capex_per_ha": "INR per hectare one-time establishment cost (perennials)",
      "establishment_years": "years from planting to first commercial harvest",
      "water_mm": "seasonal crop water requirement in mm",
      "duration_days": "days from sowing to harvest",
      "risk_score": "1 (low) to 5 (high) - combines price volatility, perishability and market-access difficulty",
      "cost_per_quintal": "INR per quintal, CACP A2+FL cost of production",
      "display_hi": "Crop name in Hindi, shown when the interface is in Hindi"
    },
    "caveat": "These are national indicative figures for a demonstration model. Production deployment must substitute district-level Agmarknet price feeds and state cost-of-cultivation surveys.",
    "cost_model": "Field crops are costed per quintal using CACP A2+FL cost of production (2024-25), so cost scales with actual yield. Horticulture and plantation crops keep a per-hectare operating cost, since their spend is driven by labour, canopy management and capital rather than tonnage."
  },
