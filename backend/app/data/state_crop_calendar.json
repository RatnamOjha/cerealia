{
  "_meta": {
    "description": "Horticulture supplement to the official area statistics in state_crop_stats.json. Lists crops known to be cultivated in each state, compiled from NHB/APEDA horticulture area statistics and state agriculture department cropping-pattern reports.",
    "why_this_exists": "The official district-wise area/production dataset is field-crop focused. It records no apple for Himachal Pradesh at all, and puts Maharashtra's grapes at 0.03% of sown area. Ranking on sown area alone structurally buries high-value crops that occupy little land - exactly the class of crop this project exists to surface. This file supplies that coverage; the official statistics remain authoritative wherever they have a record.",
    "tiers": {
      "major": "Significant cultivated area; established supply chain, mandi presence and extension support. Prior weight 1.0.",
      "minor": "Grown but on limited area, or confined to specific districts/agro-pockets. Prior weight 0.6.",
      "absent": "Not listed = not commercially cultivated in this state. Excluded from recommendation."
    },
    "limitation": "State-level granularity. A district-level prior (e.g. Nashik vs Vidarbha within Maharashtra) is the natural next iteration and is on the roadmap.",
    "precedence": "regional_prior() takes the stronger of the two signals per crop, so official statistics never get overridden downward by this list."
  },
