# xAI / Grok API key — powers BOTH the scheme chatbot and Hindi speech-to-text.
# Get one at https://console.x.ai
#
# Copy this file to backend/.env and paste your key below.
# .env is gitignored; never commit the real key.
GROK_API_KEY =

# Optional overrides
# XAI_API_KEY=            # accepted as an alias for GROK_API_KEY
# GROK_MODEL=grok-3
# GROK_API_URL=https://api.x.ai/v1/chat/completions
# GROK_STT_URL=https://api.x.ai/v1/stt
# GROK_TIMEOUT=25
